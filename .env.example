# ═══════════════════════════════════════════════════════════════
# BEAUTY SALON - PRODUCTION ENVIRONMENT
# ═══════════════════════════════════════════════════════════════
# Copia in .env e sostituisci tutti i valori segreti!
# Genera i segreti con:
#   openssl rand -hex 64   (per JWT_*, CSRF_*, COOKIE_*, NEXTAUTH_SECRET)
#   openssl rand -hex 32   (per CRON_SECRET)
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
# In docker-compose usa mongodb://mongo:27017/beauty
# Per MongoDB esterno cambia con la tua URI
MONGODB_URI=mongodb://mongo:27017/beauty

# ── WhatsApp (whatsapp-web.js) ────────────────────────────────
# Sessione persistente salvata in .wwebjs_auth/ (volume Docker)
# Al primo avvio mostra QR code: docker logs -f beauty_app_1
WHATSAPP_DEFAULT_COUNTRY_CODE=39

# ── JWT Secrets (min 64 hex = 32 byte) ────────────────────────
JWT_SECRET=openssl_rand_hex_64_qua
JWT_ACCESS_SECRET=openssl_rand_hex_64_qua
JWT_REFRESH_SECRET=openssl_rand_hex_64_qua

# ── Cookie / CSRF Secrets (min 64 hex) ────────────────────────
COOKIE_SECRET=openssl_rand_hex_64_qua
CSRF_SECRET=openssl_rand_hex_64_qua
NEXTAUTH_SECRET=openssl_rand_hex_64_qua

# ── Cron secret (min 32 hex) ──────────────────────────────────
CRON_SECRET=openssl_rand_hex_32_qua

# ── URL pubblici (sostituisci con il tuo dominio) ─────────────
NEXT_PUBLIC_APP_URL=https://tuodominio.com
NEXT_PUBLIC_BASE_URL_API=https://tuodominio.com
NEXTAUTH_URL=https://tuodominio.com

# ── Server ────────────────────────────────────────────────────
HOSTNAME=0.0.0.0
PORT=3000
