# Database
MONGODB_URI=mongodb://localhost:27017/barbershop

# WhatsApp (whatsapp-web.js)
# Usa sessione locale salvata in .wwebjs_auth/
# Al primo avvio mostra QR code nel terminale
WHATSAPP_DEFAULT_COUNTRY_CODE=39

# ⚠️ SOSTITUIRE CON VALORI REALI PRIMA DEL DEPLOY ⚠️
# Genera con: openssl rand -hex 64
JWT_SECRET=cambia_con_valore_reale_hex_64_caratteri
JWT_ACCESS_SECRET=cambia_con_valore_reale_hex_64_caratteri
JWT_REFRESH_SECRET=cambia_con_valore_reale_hex_64_caratteri
CSRF_SECRET=cambia_con_valore_reale_hex_64_caratteri
COOKIE_SECRET=cambia_con_valore_reale_hex_64_caratteri
NEXTAUTH_SECRET=cambia_con_valore_reale_hex_64_caratteri

# Protegge gli endpoint /api/cron/* e /api/test/*
# Genera con: openssl rand -hex 32
CRON_SECRET=cambia_con_valore_reale_hex_32_caratteri

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL_API=http://localhost:3000

# Server
HOSTNAME=localhost
PORT=3000
